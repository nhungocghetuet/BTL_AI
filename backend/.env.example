# Sao chép file này thành .env rồi chỉnh giá trị phù hợp
PROJECT_NAME=Smart Timetable Scheduler
PROJECT_VERSION=1.0.0
API_PREFIX=/api
DEBUG=true
DATABASE_URL=sqlite:///./timetable.db

# Viết dạng JSON list (dùng dấu nháy kép)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

